# Copy to .env.local for local dev, and set the same values in your static host (Cloudflare Pages / Netlify).
# Both values are PUBLIC by design (the anon key only works together with Row Level Security).
# Never put the Anthropic key or the Supabase service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: show the "Phone" sign-in tab (each SMS code costs money via Twilio).
# VITE_ENABLE_PHONE=true
